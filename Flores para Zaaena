<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Para Zaaena 🌻</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      overflow: hidden;
      font-family: Georgia, "Times New Roman", serif;
      background: linear-gradient(135deg, #120c24, #26143d, #4a275c);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }

    /* Estrellas */
    .stars {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    .star {
      position: absolute;
      width: 3px;
      height: 3px;
      background: #fff8c7;
      border-radius: 50%;
      animation: twinkle 2s infinite alternate;
    }

    @keyframes twinkle {
      from {
        opacity: 0.2;
        transform: scale(0.7);
      }
      to {
        opacity: 1;
        transform: scale(1.3);
      }
    }

    /* Contenedor */
    .container {
      width: min(90%, 500px);
      text-align: center;
      z-index: 5;
      padding: 30px 20px;
    }

    .flowers {
      font-size: 70px;
      margin-bottom: 15px;
      animation: float 3s ease-in-out infinite;
      filter: drop-shadow(0 0 15px rgba(255, 220, 60, 0.5));
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-12px);
      }
    }

    h1 {
      font-size: clamp(42px, 12vw, 68px);
      color: #ffe66d;
      margin-bottom: 10px;
      text-shadow: 0 0 20px rgba(255, 220, 70, 0.4);
    }

    .subtitle {
      font-size: 19px;
      opacity: 0.9;
      margin-bottom: 30px;
      line-height: 1.5;
    }

    button {
      border: none;
      background: linear-gradient(135deg, #ffd83d, #ffb700);
      color: #4a2700;
      padding: 15px 28px;
      border-radius: 30px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(255, 190, 30, 0.3);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    button:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 12px 30px rgba(255, 190, 30, 0.45);
    }

    /* Carta */
    .letter {
      display: none;
      margin-top: 25px;
      padding: 25px;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      animation: appear 0.8s ease;
      line-height: 1.7;
      font-size: 17px;
    }

    .letter.show {
      display: block;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .signature {
      margin-top: 20px;
      color: #ffe66d;
      font-size: 18px;
    }

    /* Flores que caen */
    .falling-flower {
      position: fixed;
      top: -50px;
      font-size: 25px;
      pointer-events: none;
      animation: fall linear forwards;
      z-index: 10;
    }

    @keyframes fall {
      to {
        transform: translateY(110vh) rotate(360deg);
        opacity: 0;
      }
    }

    .small {
      margin-top: 18px;
      font-size: 13px;
      opacity: 0.6;
    }
  </style>
</head>

<body>

  <div class="stars" id="stars"></div>

  <main class="container">

    <div class="flowers">🌻 🌻 🌻</div>

    <h1>Zaaena</h1>

    <p class="subtitle">
      Estas flores son especialmente para ti 💛
    </p>

    <button onclick="openLetter()">
      Hay algo que quiero decirte ✨
    </button>

    <div class="letter" id="letter">

      <p>
        Hay personas que llegan a tu vida y, sin darse cuenta,
        hacen que tus días sean un poquito más bonitos.
      </p>

      <br>

      <p>
        Tú eres una de esas personas. 🌻
      </p>

      <br>

      <p>
        Estas flores son virtuales porque no pude dártelas
        en persona... pero espero que algún día pueda hacerlo.
      </p>

      <br>

      <div class="signature">
        Con cariño, alguien que te quiere ver sonreír 🌻
      </div>

    </div>

    <div class="small">
      Hecho especialmente para ti ✨
    </div>

  </main>

  <script>

    /* Crear estrellas */
    const stars = document.getElementById("stars");

    for (let i = 0; i < 80; i++) {
      const star = document.createElement("div");

      star.className = "star";

      star.style.left = Math.random() * 100 + "%";
      star.style.top = Math.random() * 100 + "%";
      star.style.animationDelay = Math.random() * 2 + "s";

      stars.appendChild(star);
    }

    /* Abrir carta */
    function openLetter() {

      const letter = document.getElementById("letter");

      letter.classList.add("show");

      /* Crear lluvia de flores */
      for (let i = 0; i < 25; i++) {

        setTimeout(() => {

          const flower = document.createElement("div");

          flower.className = "falling-flower";
          flower.textContent = "🌻";

          flower.style.left = Math.random() * 100 + "vw";
          flower.style.animationDuration =
            (3 + Math.random() * 4) + "s";

          flower.style.fontSize =
            (18 + Math.random() * 20) + "px";

          document.body.appendChild(flower);

          setTimeout(() => {
            flower.remove();
          }, 7000);

        }, i * 120);

      }
    }

  </script>

</body>
</html>